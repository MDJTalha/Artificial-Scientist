# Set this to the HTTPS base URL of the separately deployed ASDS API.
# Leave blank for same-origin deployments; production must never point at localhost.
VITE_API_BASE_URL=

# Amazon Cognito hosted UI (OAuth authorization code + PKCE; public client, no secret)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REDIRECT_URI=https://your-asds-domain.example/auth/callback
VITE_COGNITO_LOGOUT_URI=https://your-asds-domain.example/
VITE_COGNITO_SCOPES=openid email profile asds-api/access

# Required only for tenant-scoped research, knowledge and lab APIs after membership provisioning
VITE_ASDS_TENANT_ID=
