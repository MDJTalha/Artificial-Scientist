# ASDS backend runtime configuration. Never commit credentials or real secret values.
ARTIFICIAL_SCIENTIST_ENV=production
# Comma-separated exact browser origins. Do not use *.
ARTIFICIAL_SCIENTIST_ALLOWED_ORIGINS=https://your-asds-preview.vercel.app

# Required for production. Use a secret manager for the real value.
# Example format only; never commit a real credential-bearing URL.
ARTIFICIAL_SCIENTIST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# SQLite is for explicitly configured local development only.
ARTIFICIAL_SCIENTIST_DB_PATH=/app/data/asds.sqlite3

# Auth0 API (JWT access-token validation). Replace the audience with the exact Auth0 API Identifier.
ARTIFICIAL_SCIENTIST_OIDC_ISSUER=https://asds-artificial-scientist.us.auth0.com/
ARTIFICIAL_SCIENTIST_OIDC_AUDIENCE=<exact-auth0-api-identifier>
ARTIFICIAL_SCIENT_SCIENTIST_OIDC_JWKS_URL=https://asds-artificial-scientist.us.auth0.com/.well-known/jwks.json
ARTIFICIAL_SCIENTIST_OIDC_AUDIENCE_CLAIM=aud
# Leave TOKEN_USE unset for Auth0. Configure REQUIRED_SCOPE only if that scope exists on the Auth0 API.
# ARTIFICIAL_SCIENTIST_OIDC_REQUIRED_SCOPE=asds-api/access

# Optional scholarly provider settings
OPENALEX_API_KEY=
CROSSREF_CONTACT_EMAIL=
