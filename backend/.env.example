# Production API runtime. Supply OIDC values from the selected identity provider.
ARTIFICIAL_SCIENTIST_ENV=production
ARTIFICIAL_SCIENTIST_NAME=Artificial Scientist
ARTIFICIAL_SCIENTIST_VERSION=0.1.0
ARTIFICIAL_SCIENTIST_ALLOWED_ORIGINS=https://research.example.test
# Use a durable mounted volume. Do not use an ephemeral container filesystem for production records.
ARTIFICIAL_SCIENTIST_DB_PATH=/var/lib/asds/artificial_scientist.sqlite3

# Exact issuer from OIDC discovery, including trailing slash when published by the provider.
ARTIFICIAL_SCIENTIST_OIDC_ISSUER=
# Audience of the JWT access token presented to ASDS API; may differ from SPA client ID.
ARTIFICIAL_SCIENTIST_OIDC_AUDIENCE=
# HTTPS JWKS URI published by the trusted identity provider.
ARTIFICIAL_SCIENTIST_OIDC_JWKS_URL=

# Optional provider settings. Keep secrets in a secret manager.
OPENALEX_API_KEY=
CROSSREF_CONTACT_EMAIL=
ARTIFICIAL_SCIENTIST_LAB_API_KEY=
