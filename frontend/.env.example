# Browser build-time configuration. These values are public; never put client secrets here.
# Local development can use the local API. Production must use a real HTTPS backend URL.
VITE_API_BASE_URL=http://127.0.0.1:8000

# OIDC Authorization Code + PKCE public SPA client.
# Register the exact redirect URI in the identity provider. The SPA must have no client secret.
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_SCOPES=openid profile email
# Optional RFC 8707 resource indicator for the ASDS API audience.
VITE_OIDC_RESOURCE=
