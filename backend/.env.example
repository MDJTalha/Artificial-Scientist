# ASDS backend runtime configuration (never place credentials in this file)
ARTIFICIAL_SCIENTIST_ENV=production
ARTIFICIAL_SCIENTIST_ALLOWED_ORIGINS=https://your-asds-domain.example
ARTIFICIAL_SCIENTIST_DB_PATH=/app/data/asds.sqlite3

# Amazon Cognito User Pool outputs
ARTIFICIAL_SCIENTIST_OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
ARTIFICIAL_SCIENTIST_OIDC_AUDIENCE=<user-pool-client-id>
ARTIFICIAL_SCIENTIST_OIDC_JWKS_URL=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>/.well-known/jwks.json
ARTIFICIAL_SCIENTIST_OIDC_AUDIENCE_CLAIM=client_id
ARTIFICIAL_SCIENTIST_OIDC_TOKEN_USE=access
ARTIFICIAL_SCIENTIST_OIDC_REQUIRED_SCOPE=asds-api/access

# Optional scholarly provider settings
OPENALEX_API_KEY=
CROSSREF_CONTACT_EMAIL=
