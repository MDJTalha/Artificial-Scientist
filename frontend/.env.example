# Set this to the HTTPS base URL of the separately deployed ASDS API.
# Leave blank for same-origin deployments; production must never point at localhost.
VITE_API_BASE_URL=

# Auth0 Single Page Application (public client; never add a client secret here)
VITE_AUTH0_DOMAIN=asds-artificial-scientist.us.auth0.com
VITE_AUTH0_CLIENT_ID=a0Jm8oh05S1V4hMOg0v2d84MNO56zJX8

# Required to request JWT access tokens for the ASDS FastAPI API.
# Set this to the Identifier of the Auth0 API after confirming it exists in your tenant.
VITE_AUTH0_AUDIENCE=

# Required only for tenant-scoped research, knowledge and lab APIs after membership provisioning
VITE_ASDS_TENANT_ID=
